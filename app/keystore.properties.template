# Copy this file to "keystore.properties" (same folder) and fill in your real values.
# keystore.properties is git-ignored — never commit your real passwords.
#
# Don't have a keystore yet? Generate one with (run from a terminal, needs JDK installed):
#
#   keytool -genkey -v -keystore dgmpi-release.keystore -alias dgmpi -keyalg RSA -keysize 2048 -validity 10000
#
# It will ask a few questions (name, organization, etc.) and two passwords — remember them,
# Google Play requires the SAME keystore for every future update of this app, forever.

storeFile=../dgmpi-release.keystore
storePassword=CHANGE_ME
keyAlias=dgmpi
keyPassword=CHANGE_ME
